---
import { es } from "@i18n/es";
import { menu } from "@data/menu";

const carta = es.carta;
---

<section id="carta" class="bg-paper py-16 sm:py-24" aria-labelledby="carta-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="text-sm font-semibold tracking-wide text-accent uppercase">{carta.eyebrow}</p>
    <h2 id="carta-title" class="mt-2 font-display text-3xl font-bold text-ink sm:text-4xl">
      {carta.title}
    </h2>
    <p class="mt-3 max-w-2xl text-lg text-muted">{carta.subtitle}</p>

    <nav class="mt-8" aria-label="Categorías de la carta">
      <ul class="flex flex-wrap gap-2">
        {
          menu.map((cat) => (
            <li>
              <a
                href={`#carta-${cat.id}`}
                class="inline-block rounded-full border border-line bg-cream px-4 py-2 text-sm font-medium text-brand hover:border-brand hover:bg-brand hover:text-white transition-colors"
              >
                {cat.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-10 grid gap-x-12 gap-y-12 lg:grid-cols-2">
      {
        menu.map((cat) => (
          <section id={`carta-${cat.id}`} aria-label={cat.title} class="scroll-mt-28">
            <div class="flex items-baseline gap-3">
              <h3 class="font-display text-2xl font-bold text-brand">{cat.title}</h3>
              <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
            </div>
            {cat.subtitle && <p class="mt-1 text-sm italic text-muted">{cat.subtitle}</p>}

            <ul class="mt-5 space-y-4">
              {
                cat.items.map((item) => (
                  <li>
                    <div class="flex items-start">
                      <div class="min-w-0">
                        <p class="font-semibold text-ink leading-snug">{item.name}</p>
                        {item.description && (
                          <p class="mt-0.5 text-sm text-muted leading-snug">{item.description}</p>
                        )}
                      </div>
                      <span class="leader" aria-hidden="true"></span>
                      <div class="shrink-0 text-right">
                        {item.price && (
                          <p class="font-display font-bold text-accent whitespace-nowrap">{item.price}</p>
                        )}
                        {(item.halfPrice || item.fullPrice) && (
                          <p class="text-sm whitespace-nowrap">
                            {item.halfPrice && (
                              <span>
                                <span class="text-muted">{carta.halfLabel}: </span>
                                <span class="font-display font-bold text-accent">{item.halfPrice}</span>
                              </span>
                            )}
                            {item.halfPrice && item.fullPrice && <span class="mx-1 text-line">·</span>}
                            {item.fullPrice && (
                              <span>
                                <span class="text-muted">{carta.fullLabel}: </span>
                                <span class="font-display font-bold text-accent">{item.fullPrice}</span>
                              </span>
                            )}
                          </p>
                        )}
                      </div>
                    </div>
                  </li>
                ))
              }
            </ul>

            {cat.footnote && <p class="mt-4 text-xs text-muted">{cat.footnote}</p>}
          </section>
        ))
      }
    </div>
  </div>
</section>
