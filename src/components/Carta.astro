---
import { es } from "@i18n/es";
import { menu } from "@data/menu";

const carta = es.carta;

/**
 * Tinta de cada categoría, rotando el trío del mural: verde dehesa,
 * azul agua y coral. Asignación semántica (ensaladas y revueltos de
 * campo al verde, pescado al mar, brasa y postres al coral) con
 * fallback cíclico para categorías nuevas. El color va en la
 * tipografía del título, no en fondos.
 */
type CatHue = { title: string; hand: string };

const hueVerde: CatHue = { title: "text-verde-deep", hand: "text-verde-deep" };
const hueAgua: CatHue = { title: "text-brand-deep", hand: "text-brand-deep" };
const hueCoral: CatHue = { title: "text-accent-deep", hand: "text-accent-deep" };

const catHues: Record<string, CatHue> = {
  ensaladas: hueVerde,
  tapas: hueAgua,
  tostas: hueCoral,
  revueltos: hueVerde,
  "para-compartir": hueAgua,
  hamburguesa: hueCoral,
  carnes: hueCoral,
  pescado: hueAgua,
  postres: hueVerde,
};

const hueFor = (id: string, i: number): CatHue =>
  catHues[id] ?? [hueVerde, hueAgua, hueCoral][i % 3];
---

<section id="carta" class="bg-sand" aria-labelledby="carta-title">
  <!-- Costura con la sección anterior: olas de espuma entrando en la carta -->
  <svg
    class="block h-10 w-full fill-cream sm:h-14"
    viewBox="0 0 1440 56"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0 0h1440v24c-120 22-240 22-360 0s-240-22-360 0-240 22-360 0-240-22-360 0-240 22-360 0z"
    ></path>
  </svg>

  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="reveal">
      <p class="text-sm font-semibold tracking-wide text-accent-deep uppercase">{carta.eyebrow}</p>
      <h2 id="carta-title" class="mt-2 font-display text-3xl font-bold text-ink sm:text-4xl">
        {carta.title}
      </h2>
      <p class="mt-3 max-w-2xl text-lg text-muted">{carta.subtitle}</p>
    </div>

    <nav class="mt-8" aria-label="Categorías de la carta">
      <ul class="flex flex-wrap gap-2">
        {
          menu.map((cat) => (
            <li>
              <a
                href={`#carta-${cat.id}`}
                class="inline-block rounded-full border border-line/80 bg-paper px-4 py-2 text-sm font-medium text-muted transition-colors hover:border-brand hover:text-brand-deep"
              >
                {cat.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {
        menu.map((cat, i) => {
          const hue = hueFor(cat.id, i);
          return (
            <section
              id={`carta-${cat.id}`}
              aria-label={cat.title}
              class="scroll-mt-28 rounded-3xl border border-line/70 bg-paper p-6 shadow-sm sm:p-8 min-w-0"
            >
              <div class="flex items-baseline gap-3">
                <h3 class={`font-display text-2xl font-bold sm:text-[1.7rem] ${hue.title}`}>
                  {cat.title}
                </h3>
                <span class="h-px flex-1 bg-ink/10" aria-hidden="true"></span>
              </div>
              {cat.subtitle && (
                <p class={`mt-2 font-hand text-2xl leading-snug ${hue.hand}`}>{cat.subtitle}</p>
              )}

              <ul class="mt-5 space-y-4">
                {cat.items.map((item) =>
                  item.price ? (
                    <li>
                      <div class="flex items-start">
                        <div class="min-w-0">
                          <p class="font-semibold text-ink leading-snug">{item.name}</p>
                          {item.description && (
                            <p class="mt-0.5 text-sm text-muted leading-snug">
                              {item.description}
                            </p>
                          )}
                        </div>
                        <span class="leader" aria-hidden="true"></span>
                        <div class="shrink-0 text-right">
                          <p class="font-hand text-2xl font-bold leading-none text-accent-deep whitespace-nowrap">
                            {item.price}
                          </p>
                        </div>
                      </div>
                    </li>
                  ) : (
                    /* En móvil el bloque de media/ración entera baja a su
                       propia línea: evita que el nombre quede aplastado en
                       una columna estrecha. En sm+ mantiene el punteado. */
                    <li>
                      <div class="sm:flex sm:items-start">
                        <div class="min-w-0">
                          <p class="font-semibold text-ink leading-snug">{item.name}</p>
                          {item.description && (
                            <p class="mt-0.5 text-sm text-muted leading-snug">
                              {item.description}
                            </p>
                          )}
                        </div>
                        <span class="leader hidden sm:block" aria-hidden="true"></span>
                        <div class="mt-1 shrink-0 sm:mt-0 sm:text-right">
                          <p class="text-sm whitespace-nowrap">
                            {item.halfPrice && (
                              <span>
                                <span class="text-muted">{carta.halfLabel}: </span>
                                <span class="font-hand text-xl font-bold leading-none text-accent-deep">
                                  {item.halfPrice}
                                </span>
                              </span>
                            )}
                            {item.halfPrice && item.fullPrice && (
                              <span class="mx-1 text-line">·</span>
                            )}
                            {item.fullPrice && (
                              <span>
                                <span class="text-muted">{carta.fullLabel}: </span>
                                <span class="font-hand text-xl font-bold leading-none text-accent-deep">
                                  {item.fullPrice}
                                </span>
                              </span>
                            )}
                          </p>
                        </div>
                      </div>
                    </li>
                  ),
                )}
              </ul>

              {cat.footnote && <p class="mt-4 font-hand text-xl text-muted">{cat.footnote}</p>}
            </section>
          );
        })
      }
    </div>
  </div>

  <!-- Costura con la sección siguiente: la carta cae al mar profundo -->
  <svg
    class="block h-10 w-full fill-brand-deep sm:h-14"
    viewBox="0 0 1440 56"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0 40c120-16 240-16 360 0s240 16 360 0 240-16 360 0 240 16 360 0 240-16 360 0v16H0z"
    ></path>
  </svg>
</section>
