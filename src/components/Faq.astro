---
import { es } from "@i18n/es";

const faq = es.faq;
---

<section id="faq" class="bg-cream py-16 sm:py-24" aria-labelledby="faq-title">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="reveal">
      <p class="text-sm font-semibold tracking-wide text-accent uppercase">{faq.eyebrow}</p>
      <h2 id="faq-title" class="mt-2 font-display text-3xl font-bold text-ink sm:text-4xl">
        {faq.title}
      </h2>
    </div>

    <div class="mt-8 space-y-3">
      {
        faq.items.map((item) => (
          <details class="faq-item rounded-2xl border border-line bg-paper px-5 py-4 shadow-sm">
            <summary class="flex items-center justify-between gap-4 font-semibold text-ink">
              {item.q}
            </summary>
            <p class="mt-3 leading-relaxed text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
