---
import { es } from "@i18n/es";
import SocialLinks from "@components/SocialLinks.astro";

const footer = es.footer;
const year = new Date().getFullYear();
---

<footer class="bg-ink text-white/80" aria-label="Pie de página">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-3">
          <img
            src="/images/logo-calle13.webp"
            alt=""
            width="800"
            height="800"
            class="h-12 w-12 rounded-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <p class="font-display text-xl font-semibold text-white">
            {es.site.name}
          </p>
        </div>
        <p class="mt-3 text-white/60">{footer.tagline}</p>
      </div>

      <nav aria-label="Navegación del pie de página">
        <h2 class="text-sm font-semibold tracking-wide text-white uppercase">{footer.navTitle}</h2>
        <ul class="mt-4 space-y-2.5">
          {
            es.header.nav.map((item) => (
              <li>
                <a href={item.href} class="hover:text-white transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-sm font-semibold tracking-wide text-white uppercase">{footer.contactTitle}</h2>
        <a
          href={es.site.phoneHref}
          class="mt-4 inline-flex items-center gap-2 font-display text-2xl font-bold text-white hover:text-cream transition-colors"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          {es.site.phone}
        </a>
        <a
          href={es.site.mapsUrl}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-flex items-center gap-2 text-white/70 transition-colors hover:text-white"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          {es.site.location}
        </a>
        <div class="mt-4 flex items-center gap-4">
          <span class="text-sm text-white/50">{footer.followUs}</span>
          <SocialLinks />
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 text-sm text-white/50 sm:flex-row">
      <p>© {year} {es.site.name}. {footer.rights}</p>
      <p>
        {footer.madeBy}{" "}
        <a href="https://noxell.dev" class="font-semibold text-white/80 hover:text-white transition-colors">
          noxell.dev
        </a>
      </p>
    </div>
  </div>
</footer>
