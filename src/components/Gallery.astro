---
import { es } from "@i18n/es";

const gallery = es.gallery;
---

<section id="galeria" class="bg-cream py-16 sm:py-24" aria-labelledby="galeria-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="text-sm font-semibold tracking-wide text-accent uppercase">{gallery.eyebrow}</p>
    <h2 id="galeria-title" class="mt-2 font-display text-3xl font-bold text-ink sm:text-4xl">
      {gallery.title}
    </h2>
    <p class="mt-3 max-w-2xl text-lg text-muted">{gallery.subtitle}</p>

    <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5">
      {
        gallery.images.map((img) => (
          <li class="overflow-hidden rounded-2xl border border-line bg-paper shadow-sm">
            <img
              src={img.src}
              alt={img.alt}
              width={img.width}
              height={img.height}
              loading="lazy"
              decoding="async"
              class="aspect-square w-full object-cover"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
