---
import { es } from "@i18n/es";

const gallery = es.gallery;
---

<section id="galeria" class="bg-cream py-16 sm:py-24" aria-labelledby="galeria-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal">
      <p class="text-sm font-semibold tracking-wide text-accent-deep uppercase">{gallery.eyebrow}</p>
      <h2 id="galeria-title" class="mt-2 font-display text-3xl font-bold text-ink sm:text-4xl">
        {gallery.title}
      </h2>
      <p class="mt-3 max-w-2xl text-lg text-muted">{gallery.subtitle}</p>
    </div>

    <ul
      class="-mx-4 mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-3 scroll-px-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-5 sm:overflow-visible sm:px-0 sm:pb-0 sm:scroll-px-0"
    >
      {
        gallery.images.map((img, i) => (
          <li
            class="reveal w-[72vw] max-w-[320px] shrink-0 snap-start overflow-hidden rounded-2xl border border-line bg-paper shadow-sm sm:w-auto"
            style={`--reveal-delay: ${(i % 6) * 60}ms`}
          >
            <img
              src={img.src}
              alt={img.alt}
              width={img.width}
              height={img.height}
              loading="lazy"
              decoding="async"
              data-fade
              class="aspect-[4/5] w-full object-cover sm:aspect-square"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
