---
import { es } from "@i18n/es";
import { site } from "@data/site";
import { christmasMenus } from "@data/navidad";

const t = es.navidad;

/**
 * Tinta de cada menú, rotando el trío del mural como en la carta:
 * verde dehesa, azul agua y coral. El color va en la tipografía
 * del título del bloque y en la frase de cierre, no en fondos.
 */
type MenuHue = { title: string; hand: string };

const hues: MenuHue[] = [
  { title: "text-verde-deep", hand: "text-verde-deep" },
  { title: "text-brand-deep", hand: "text-brand-deep" },
  { title: "text-accent-deep", hand: "text-accent-deep" },
];
---

<section id="navidad" class="bg-pino text-white" aria-labelledby="navidad-title">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="reveal">
      <p class="text-sm font-semibold tracking-wide text-amber-300 uppercase">{t.eyebrow}</p>
      <h2 id="navidad-title" class="mt-2 font-display text-3xl font-bold sm:text-4xl">
        {t.title}
      </h2>
      <p class="mt-3 max-w-2xl text-lg text-white/80">{t.subtitle}</p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {
        christmasMenus.map((menu, i) => {
          const hue = hues[i % hues.length];
          const featured = menu.id === "navidad-55";
          return (
            <article
              class={`reveal flex min-w-0 flex-col rounded-3xl bg-paper p-6 text-ink shadow-sm sm:p-8 ${featured ? "ring-2 ring-amber-400/80" : ""}`}
              style={`--reveal-delay: ${i * 100}ms`}
              aria-label={`Menú de Navidad ${menu.price}`}
            >
              <p class="font-hand text-6xl leading-none font-bold text-accent-deep">
                {menu.price}
              </p>
              <p class="mt-2 text-sm font-medium text-muted">{menu.minPeople}</p>
              <span class="mt-5 h-px bg-ink/10" aria-hidden="true"></span>

              {menu.groups.map((group) => (
                <div class="mt-5">
                  <h3 class={`text-sm font-bold tracking-wide uppercase ${hue.title}`}>
                    {group.title}
                  </h3>
                  <ul class="mt-3 space-y-2">
                    {group.items.map((dish) => (
                      <li class="flex items-start gap-2.5">
                        <span
                          class="mt-2 size-1.5 shrink-0 rounded-full bg-amber-500"
                          aria-hidden="true"
                        ></span>
                        <span class="font-medium leading-snug">{dish}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}

              <div class="mt-5 border-t border-ink/10 pt-4 text-sm leading-relaxed">
                <p>
                  <span class="font-bold">{t.dessertsLabel}: </span>
                  {menu.desserts}
                </p>
                <p class="mt-2">
                  <span class="font-bold">{t.drinksLabel}: </span>
                  {menu.drinks}
                  {menu.drinksNote && (
                    <span class="font-hand text-xl text-muted"> ({menu.drinksNote})</span>
                  )}
                </p>
              </div>

              <p class={`mt-auto pt-6 font-hand text-3xl leading-snug ${hue.hand}`}>
                {menu.slogan}
              </p>
            </article>
          );
        })
      }
    </div>

    <div class="reveal mt-10 text-center">
      <a
        href={site.phones[0].href}
        class="inline-flex items-center gap-3 rounded-full bg-white px-5 py-3 text-base font-bold whitespace-nowrap text-pino-deep shadow-lg transition-colors hover:bg-cream sm:px-8 sm:py-4 sm:text-xl"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        {t.cta} · {site.phones[0].display}
      </a>
    </div>
  </div>

  <!-- Costura con la sección siguiente: la Navidad cae al mar profundo -->
  <svg
    class="block h-10 w-full fill-brand-deep sm:h-14"
    viewBox="0 0 1440 56"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0 40c120-16 240-16 360 0s240 16 360 0 240-16 360 0 240 16 360 0 240-16 360 0v16H0z"
    ></path>
  </svg>
</section>
