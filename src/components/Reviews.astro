---
import { es } from "@i18n/es";
import { reviews } from "@data/reviews";

const site = es.site;
const t = es.reviews;

const ratingDisplay = site.googleRating.value.toFixed(1).replace(".", ",");
const ratingPercent = (site.googleRating.value / 5) * 100;

const starPath =
  "M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z";
---

<section id="resenas" class="bg-brand-deep py-16 text-white sm:py-24" aria-labelledby="resenas-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="text-sm font-semibold tracking-wide text-accent uppercase">{t.eyebrow}</p>
    <h2 id="resenas-title" class="mt-2 font-display text-3xl font-bold sm:text-4xl">
      {t.title}
    </h2>

    <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
      <p class="font-display text-6xl font-bold sm:text-7xl">{ratingDisplay}</p>
      <div>
        <span class="relative inline-flex" role="img" aria-label={`${ratingDisplay} de 5 estrellas`}>
          <span class="flex gap-1 text-white/20" aria-hidden="true">
            {Array.from({ length: 5 }).map(() => (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d={starPath} />
              </svg>
            ))}
          </span>
          <span class="absolute inset-y-0 left-0 overflow-hidden" style={`width: ${ratingPercent}%`} aria-hidden="true">
            <span class="flex w-max gap-1 text-amber-400">
              {Array.from({ length: 5 }).map(() => (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                  <path d={starPath} />
                </svg>
              ))}
            </span>
          </span>
        </span>
        <p class="mt-2">
          <a
            href={site.reviewsUrl}
            target="_blank"
            rel="noopener"
            class="font-semibold text-white/80 underline decoration-white/30 underline-offset-4 transition-colors hover:text-white"
          >
            {site.googleRating.reviewCount} {t.googleLabel}
          </a>
        </p>
      </div>
    </div>

    <ol class="mt-12 max-w-3xl divide-y divide-dashed divide-white/15">
      {reviews.map((review) => (
        <li class="py-8 first:pt-0 last:pb-0">
          <span aria-hidden="true" class="font-display text-5xl leading-none text-accent">“</span>
          <blockquote class="mt-1 font-display text-xl leading-relaxed text-white/90 italic sm:text-2xl">
            {review.text}
          </blockquote>
          <p class="mt-4 text-sm font-semibold tracking-wide text-white/60 uppercase">
            {review.name} <span class="font-normal normal-case">· {t.sourceLabel}</span>
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
