---
import { es } from "@i18n/es";
import { reviews } from "@data/reviews";

const site = es.site;
const t = es.reviews;

function starRow(count: number): number[] {
  return Array.from({ length: count }, (_, i) => i);
}

const ratingDisplay = site.googleRating.value.toFixed(1).replace(".", ",");
---

<section id="resenas" class="bg-brand-deep py-16 text-white sm:py-24" aria-labelledby="resenas-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="text-sm font-semibold tracking-wide text-white/60 uppercase">{t.eyebrow}</p>
    <h2 id="resenas-title" class="mt-2 font-display text-3xl font-bold sm:text-4xl">
      {t.title}
    </h2>
    <p class="mt-3 max-w-2xl text-lg text-white/70">{t.subtitle}</p>

    <div class="mt-8">
      <a
        href={site.reviewsUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-2.5 font-bold text-white transition-colors hover:border-amber-400/60"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-amber-400" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" />
        </svg>
        <span>{ratingDisplay} · {site.googleRating.reviewCount} {t.googleLabel}</span>
      </a>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {reviews.map((review) => (
        <figure class="flex flex-col rounded-2xl border border-white/10 bg-white/5 p-7">
          <div class="mb-4 flex gap-1" role="img" aria-label={`${review.stars} de 5 estrellas`}>
            {starRow(review.stars).map(() => (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-amber-400" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" />
              </svg>
            ))}
          </div>
          <blockquote class="flex-1 leading-relaxed text-white/80">
            “{review.text}”
          </blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            <span aria-hidden="true" class="flex h-10 w-10 items-center justify-center rounded-full bg-cream/15 font-display text-lg text-cream">
              {review.name.charAt(0)}
            </span>
            <span>
              <span class="block font-bold">{review.name}</span>
              <span class="block text-sm text-white/50">{t.sourceLabel}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
