---
import { es } from "@i18n/es";

const services = es.services;

const icons: Record<string, string> = {
  tapa: '<path d="M4 16.5h16"/><path d="M6.5 16.5a5.5 5.5 0 0 1 11 0"/><circle cx="12" cy="9" r="1"/><path d="M3 20h18"/>',
  compartir:
    '<circle cx="6.5" cy="12" r="2.5"/><circle cx="17.5" cy="5.5" r="2.5"/><circle cx="17.5" cy="18.5" r="2.5"/><path d="M8.7 10.7l6.6-3.9M8.7 13.3l6.6 3.9"/>',
  brasa:
    '<path d="M12 21.5c3.9 0 6.5-2.7 6.5-6.2 0-3.8-3.2-5.3-4.3-8.8-.9 1.6-2 2.7-2.2 4.2-.5-1-1.2-3.3-1.2-5.7-2.3 1.9-5.3 4.9-5.3 9.3 0 4.1 2.9 7.2 6.5 7.2z"/>',
  mar: '<ellipse cx="13.5" cy="12" rx="6.5" ry="4.2"/><path d="M7 12L3.5 8.5v7z"/><circle cx="16.5" cy="11" r="0.9" fill="currentColor" stroke="none"/>',
  revuelto:
    '<path d="M12 3.5c2.8 0 3.8 1.8 5.6 2.8s3.4 2.8 3.4 5.2-2.4 9-9 9-9-3.4-9-8.4 2.8-4.3 4-6.3 1.7-2.3 5-2.3z"/><circle cx="12" cy="12" r="2.8"/>',
  postre:
    '<path d="M4 20.5h16"/><path d="M5.5 20.5v-5.5L12 7l6.5 8v5.5"/><path d="M5.5 15h13"/><circle cx="12" cy="4.5" r="1.1"/>',
};
---

<section id="servicios" class="bg-cream py-16 sm:py-24" aria-labelledby="servicios-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="text-sm font-semibold tracking-wide text-accent uppercase">{services.eyebrow}</p>
    <h2 id="servicios-title" class="mt-2 font-display text-3xl font-bold text-ink sm:text-4xl">
      {services.title}
    </h2>
    <p class="mt-3 max-w-2xl text-lg text-muted">{services.subtitle}</p>

    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.items.map((item) => (
          <li class="group rounded-2xl border border-line bg-paper p-6 shadow-sm transition-shadow hover:shadow-md">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-brand/10 text-brand">
              <svg
                width="26"
                height="26"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[item.icon]}
              />
            </span>
            <h3 class="mt-4 font-display text-xl font-semibold text-ink">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
