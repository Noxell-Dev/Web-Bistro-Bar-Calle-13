---
import { es } from "@i18n/es";

const stats = es.stats;
---

<section class="bg-brand-deep text-white" aria-label={stats.title}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
    <h2 class="sr-only">{stats.title}</h2>
    <dl class="grid grid-cols-2 gap-8 text-center lg:grid-cols-4">
      {
        stats.items.map((item) => (
          <div class="flex flex-col items-center gap-1">
            <dt class="order-2 text-sm font-medium text-white/70">{item.label}</dt>
            <dd class="order-1 font-display text-4xl font-bold text-white sm:text-5xl" data-countup>
              {item.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
