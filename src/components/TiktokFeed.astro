---
import { es } from "@i18n/es";
import { tiktokVideos } from "@data/tiktok";

const t = es.tiktok;
---

<section id="videos" class="bg-cream py-16 sm:py-24" aria-labelledby="videos-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal">
      <p class="text-sm font-semibold tracking-wide text-accent uppercase">{t.eyebrow}</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <h2 id="videos-title" class="font-display text-3xl font-bold text-ink sm:text-4xl">
          {t.title}
        </h2>
      <a
        href={t.profileUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border-2 border-ink px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-ink hover:text-white"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
        </svg>
        {t.profileCta}
      </a>
    </div>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      {t.text}
    </p>
    </div>

    {tiktokVideos.length > 0 && (
      <div
        id="videos-grid"
        data-videos={JSON.stringify(tiktokVideos)}
        class="mt-10 grid gap-8 md:grid-cols-3"
      >
        {tiktokVideos.map(() => (
          <div class="flex justify-center" aria-hidden="true">
            <div class="aspect-[9/16] w-full max-w-[325px] animate-pulse rounded-xl bg-sand"></div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<script>
  // Los embeds de TikTok son pesados: solo se cargan cuando la sección
  // está a punto de entrar en pantalla, para no lastrar la carga inicial.
  const grid = document.getElementById("videos-grid");
  if (grid) {
    const loadVideos = () => {
      const videos = JSON.parse(grid.dataset.videos || "[]");
      grid.innerHTML = videos
        .map(
          (v) => `
        <div class="flex justify-center">
          <blockquote
            class="tiktok-embed"
            cite="${v.url}"
            data-video-id="${v.id}"
            style="max-width: 605px; min-width: 325px;"
          >
            <section>
              <a target="_blank" title="@samuelmanzanaresv" href="${v.url}">
                @samuelmanzanaresv
              </a>
            </section>
          </blockquote>
        </div>`,
        )
        .join("");
      const s = document.createElement("script");
      s.src = "https://www.tiktok.com/embed.js";
      s.async = true;
      document.body.appendChild(s);
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              loadVideos();
              io.disconnect();
            }
          });
        },
        { rootMargin: "400px" },
      );
      io.observe(grid);
    } else {
      loadVideos();
    }
  }
</script>
